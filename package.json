{
  "name": "market-environment-interpreter",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:backend": "bash -lc \"cd backend && source .venv/bin/activate && uvicorn main:app --host 127.0.0.1 --port 8000\"",
    "dev:frontend": "cd frontend && npm run dev -- --port 3000",
    "dev:all": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
